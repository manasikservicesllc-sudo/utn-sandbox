    "version": "1.0.0",
    "description": "Prototype companion contract. Guide-shaped fields are preserved; this is not the ministry endpoint and does not implement full ministry validation."
  },
  "servers": [
    {
      "url": "http://localhost:4101/api",
      "description": "Local UTN service"
    },
    {
      "url": "https://api.utn-staging.com",
      "description": "Hosted partner sandbox API"
    }
  ],
  "security": [
    {},
    {
      "PartnerApiKey": []
    }
