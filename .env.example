OTA_PORT=4100
UTN_PORT=4101
UTN_WEB_URL=http://localhost:8081/?token=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
# Optional: actual vision assessment. Never expose this key in browser/Expo variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: defaults to a persisted random local secret in data/settings.json.
SERVICE_SECRET=
# Partner sandbox key; if absent, a distinct random local key is saved to data/settings.json.
SANDBOX_PARTNER_API_KEY=
# Only this pre-registered URL receives external partner callbacks. No arbitrary request URL is fetched.
PARTNER_CALLBACK_URL=
PARTNER_CALLBACK_SECRET=
# Explicit public demonstration mode: intake/status need no partner key and CORS accepts any origin.
# Keep false for private environments. Invitation tokens and callback signatures remain required.
PUBLIC_SANDBOX=false
