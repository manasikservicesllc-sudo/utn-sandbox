{
  "name": "manasik-utn-experience",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/ota",
    "apps/utn"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ota": "npm run dev -w apps/ota",
    "dev:utn": "npm run web -w apps/utn",
    "dev:api": "node server/start.mjs",
    "build": "npm run build -w apps/ota",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check -w apps/ota"
  }
}
